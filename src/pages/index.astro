---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactLinks from '../components/ContactLinks.astro';
import HeroCurve from '../components/HeroCurve.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { selectFeatured } from '../lib/projects.ts';

const author = await getEntry('profile', 'author');
if (!author) throw new Error('src/data/profile.yaml must define `author`.');
const { name, role, strengths, contact } = author.data;
// Up to three featured projects; the build fails if none is featured (FR-007).
const featured = selectFeatured(await getCollection('projects'), 3);
---

<BaseLayout
  title={`${name} · Portfolio`}
  description={`${name}'s portfolio: selected projects, experience, and a few math-flavoured experiments.`}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__text">
      <p class="label hero__eyebrow">Portfolio</p>
      <h1 id="hero-title" class="hero__name">{name}</h1>
      <p class="hero__role">{role}</p>

      <ol class="hero__strengths" role="list" aria-label="Strengths">
        {
          strengths.map((strength, index) => (
            <li>
              <span class="label" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span>{strength}</span>
            </li>
          ))
        }
      </ol>

      <div class="hero__actions">
        <a class="button button--primary" href="/projects/">
          View projects <span class="button__arrow" aria-hidden="true">→</span>
        </a>
        <a class="button button--secondary" href={`mailto:${contact.email}`}>Get in touch</a>
        <ContactLinks variant="compact" />
      </div>
    </div>

    <div class="hero__art">
      <HeroCurve />
    </div>
  </section>

  <section class="selected section" aria-labelledby="selected-title">
    <div class="section-head selected__head">
      <p class="label">Selected work</p>
      <h2 id="selected-title">Things I’ve built</h2>
    </div>
    <ol class="selected__list" role="list">
      {
        featured.map((project, index) => (
          <li>
            <ProjectCard project={project} index={index} headingLevel={3} />
          </li>
        ))
      }
    </ol>
    <p class="selected__more">
      <a class="button button--secondary" href="/projects/">
        View all projects <span class="button__arrow" aria-hidden="true">→</span>
      </a>
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }

  .hero__text {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-s);
    min-width: 0;
  }

  .hero__eyebrow {
    margin-block-end: calc(-1 * var(--space-2xs));
  }

  .hero__name {
    font-size: var(--step-display);
    line-height: 0.95;
    letter-spacing: -0.03em;
    view-transition-name: page-title;
  }

  .hero__role {
    max-width: 34ch;
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: var(--leading-snug);
    color: var(--color-muted);
  }

  .hero__strengths {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: var(--space-s) var(--space-m);
    margin: var(--space-2xs) 0 0;
    padding: 0;
    list-style: none;
  }

  .hero__strengths li {
    display: grid;
    gap: var(--space-3xs);
    padding-block-start: var(--space-2xs);
    border-block-start: 1px solid var(--color-rule);
    font-weight: 500;
    line-height: var(--leading-snug);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s);
    margin-block-start: var(--space-2xs);
  }

  .selected {
    margin-block-start: var(--space-2xl);
  }

  .selected__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-end: 1px solid var(--color-rule);
  }

  .selected__more {
    margin-block-start: var(--space-l);
  }

  /* Phones: the curve sits behind the heading as a quiet watermark that ignores the pointer. */
  .hero__art {
    position: absolute;
    inset-block-start: calc(-1 * var(--space-l));
    inset-inline-end: calc(-1 * var(--gutter));
    width: min(75vw, 22rem);
    opacity: 0.2;
    z-index: 0;
    pointer-events: none;
  }

  @media (min-width: 56rem) {
    .hero {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      min-height: min(34rem, calc(100svh - 14rem));
    }

    /* Wide screens: beside the text, and it spins while the pointer is over it. */
    .hero__art {
      position: static;
      width: 100%;
      max-width: 34rem;
      justify-self: end;
      opacity: 1;
      pointer-events: auto;
    }
  }
</style>
