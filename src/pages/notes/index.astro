---
// All notes, newest first.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteList from '../../components/NoteList.astro';
import { sortNotes } from '../../lib/notes.ts';

const notes = sortNotes(await getCollection('notes'));
---

<BaseLayout
  title="Notes · Athena Fung"
  description="Short write-ups by Athena Fung on systems performance, graphics and the maths behind this site."
>
  <header class="page-head">
    <h1 class="page-head__title">Notes</h1>
    <p class="page-head__intro">Short write-ups on performance, graphics and the maths behind this site.</p>
  </header>

  {notes.length > 0 ? <NoteList notes={notes} /> : <p class="page-head__intro">No notes yet.</p>}
</BaseLayout>

<style>
  .page-head {
    display: grid;
    gap: var(--space-2xs);
    max-width: var(--measure);
    margin-block-end: var(--space-xl);
  }

  .page-head__title {
    font-size: var(--step-5);
    view-transition-name: page-title;
  }

  .page-head__intro {
    font-size: var(--step-1);
    color: var(--color-muted);
  }
</style>
