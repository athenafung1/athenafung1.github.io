---
// Shell for a project detail page (FR-033): header, case-study body, links back to all projects.
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ProjectEmblem from '../components/ProjectEmblem.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  ogImage?: string;
}

const { project, ogImage } = Astro.props;
const { title, detailDescription, period, tech, links } = project.data;
const typeLabel = { repository: 'Repository', demo: 'Live demo', writeup: 'Writeup', publication: 'Publication' } as const;
---

<BaseLayout title={`${title} · Athena Fung`} description={detailDescription ?? project.data.summary} ogImage={ogImage}>
  <article class="case-study">
    <a class="back label" href="/projects/"><span aria-hidden="true">←</span> All projects</a>

    <header class="case-study__head">
      <ProjectEmblem seed={project.id} class="case-study__emblem" />
      {period && <p class="label">{period}</p>}
      <h1 class="case-study__title">{title}</h1>
      <ul class="case-study__tech" role="list" aria-label="Technologies">
        {tech.map((item) => <li>{item}</li>)}
      </ul>
      <ul class="case-study__links" role="list">
        {
          links.map((link) => (
            <li>
              <a class="button button--secondary" href={link.url} rel="noopener">
                {link.label ?? typeLabel[link.type]}
                <span class="visually-hidden"> for {title}</span>
                <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </header>

    <div class="case-study__body prose">
      <slot />
    </div>

    <a class="back label" href="/projects/"><span aria-hidden="true">←</span> All projects</a>
  </article>
</BaseLayout>

<style>
  .case-study {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-l);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: var(--tap);
    width: fit-content;
    text-decoration: none;
    color: var(--color-muted);
  }

  .case-study__head {
    display: grid;
    gap: var(--space-s);
    padding-block-end: var(--space-l);
    border-block-end: 1px solid var(--color-rule);
  }

  .case-study__head :global(.case-study__emblem) {
    width: 4rem;
  }

  @media (min-width: 48rem) {
    .case-study__head {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: var(--space-l);
    }

    .case-study__head > :global(*) {
      grid-column: 1;
    }

    .case-study__head > :global(.case-study__emblem) {
      grid-column: 2;
      grid-row: 1 / span 4;
      align-self: center;
      width: clamp(7rem, 14vw, 11rem);
    }
  }

  .case-study__title {
    font-size: var(--step-5);
    max-width: 20ch;
    view-transition-name: page-title;
  }

  .case-study__tech,
  .case-study__links {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case-study__tech {
    gap: var(--space-3xs) var(--space-xs);
    font-size: var(--step--1);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.05em;
    color: var(--color-muted);
  }

  /* Separator after each item, so a wrapped line never starts with a dot. */
  .case-study__tech li:not(:last-child)::after {
    content: '·';
    margin-inline-start: var(--space-xs);
    color: var(--color-border);
  }

  .case-study__links {
    gap: var(--space-2xs);
  }

  /* Rendered Markdown: section headings get the editorial rule; code blocks scroll, never the page. */
  .case-study__body :global(h2) {
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-s);
    border-block-start: 2px solid var(--color-text);
    font-size: var(--step-3);
  }

  .case-study__body :global(h2:first-child) {
    margin-block-start: 0;
  }

  .case-study__body :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    padding: var(--space-s);
    border-radius: var(--radius-m);
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .case-study__body :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }

  .case-study__body :global(.astro-code),
  .case-study__body :global(.astro-code span) {
    color: light-dark(var(--shiki-light), var(--shiki-dark));
  }

  .case-study__body :global(img) {
    border-radius: var(--radius-m);
  }
</style>
