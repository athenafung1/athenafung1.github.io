---
// A list of notes, newest first: date, title (linking to the note) and its one-line description.
// Used on /notes/ (with tags and reading time) and on the landing page (`compact`).
import type { CollectionEntry } from 'astro:content';
import { formatNoteDate, isoDate, readingMinutes } from '../lib/notes.ts';

interface Props {
  notes: CollectionEntry<'notes'>[];
  /** h2 on /notes/, h3 under the landing page's section heading. */
  headingLevel?: 2 | 3;
  compact?: boolean;
}

const { notes, headingLevel = 2, compact = false } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<ol class:list={['notes', { 'notes--compact': compact }]} role="list">
  {
    notes.map((note) => (
      <li class="note-item">
        <time class="label note-item__date" datetime={isoDate(note.data.date)}>
          {formatNoteDate(note.data.date)}
        </time>
        <div class="note-item__body">
          <Heading class="note-item__title">
            <a href={`/notes/${note.id}/`}>{note.data.title}</a>
          </Heading>
          <p class="note-item__description">{note.data.description}</p>
          {!compact && (
            <p class="label note-item__meta">
              <span>{readingMinutes(note.body ?? '')} min read</span>
              {note.data.tags.length > 0 && <span>{note.data.tags.join(', ')}</span>}
            </p>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .notes {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-end: 1px solid var(--color-rule);
  }

  /* The whole row opens the note; the title link stretches over it. */
  .note-item {
    position: relative;
    display: grid;
    gap: var(--space-3xs) var(--space-l);
    padding-block: var(--space-m);
    border-block-start: 1px solid var(--color-rule);
  }

  .note-item__body {
    display: grid;
    gap: var(--space-2xs);
    max-width: var(--measure);
  }

  .note-item__title {
    font-size: var(--step-2);
  }

  .notes--compact .note-item__title {
    font-size: var(--step-1);
  }

  .note-item__title a {
    text-decoration: none;
  }

  .note-item__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .note-item__description {
    color: var(--color-muted);
  }

  .note-item__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-s);
  }

  @media (hover: hover) {
    .note-item:hover .note-item__title a {
      color: var(--color-accent);
    }
  }

  /* Wide screens: the date in its own column, like the About timeline used to be. */
  @media (min-width: 48rem) {
    .note-item {
      grid-template-columns: 9rem minmax(0, 1fr);
    }

    .note-item__date {
      padding-block-start: 0.4em;
    }
  }
</style>
