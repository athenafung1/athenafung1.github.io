---
// Plain links, no JavaScript (FR-003). `compact` is the icon row in the landing hero;
// `footer` (default) is the labelled list in every page footer.
import { getEntry } from 'astro:content';

interface Props {
  variant?: 'footer' | 'compact';
}

const { variant = 'footer' } = Astro.props;
const author = await getEntry('profile', 'author');
if (!author) throw new Error('ContactLinks: src/data/profile.yaml must define `author`.');
const { name, contact } = author.data;

const links = [
  { id: 'email', href: `mailto:${contact.email}`, label: 'Email', text: contact.email, name: `Email ${name}` },
  { id: 'github', href: contact.github, label: 'GitHub', text: 'GitHub', name: `${name} on GitHub` },
  { id: 'linkedin', href: contact.linkedin, label: 'LinkedIn', text: 'LinkedIn', name: `${name} on LinkedIn` },
] as const;
---

<ul class:list={['contact', `contact--${variant}`]} role="list">
  {
    links.map((link) => (
      <li>
        <a class="contact__link tap-target" href={link.href} aria-label={variant === 'compact' ? link.name : undefined}>
          <svg class="contact__icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            {link.id === 'email' && (
              <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="m3.5 6.5 8.5 6.5 8.5-6.5" />
              </g>
            )}
            {link.id === 'github' && (
              <path
                fill="currentColor"
                transform="translate(4 4)"
                d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
              />
            )}
            {link.id === 'linkedin' && (
              <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="3" />
                <path d="M8 10.5V17M8 7.25v.01M12 17v-6.5M12 13.5c0-1.8 1.1-3 2.6-3S17 11.6 17 13.3V17" />
              </g>
            )}
          </svg>
          {variant === 'footer' ? <span>{link.text}</span> : <span class="visually-hidden">{link.label}</span>}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .contact__link {
    gap: var(--space-2xs);
    text-decoration: none;
    border-radius: var(--radius-m);
    color: var(--color-text);
  }

  .contact__icon {
    flex: none;
  }

  .contact--footer .contact__link {
    justify-content: flex-start;
    padding-inline: var(--space-3xs);
  }

  .contact--compact {
    gap: var(--space-2xs);
  }

  .contact--compact .contact__link {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    transition:
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  @media (hover: hover) {
    .contact__link:hover {
      color: var(--color-accent);
    }

    .contact--compact .contact__link:hover {
      border-color: var(--color-accent);
      transform: translateY(-2px);
    }
  }
</style>
