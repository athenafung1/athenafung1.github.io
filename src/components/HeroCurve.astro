---
// Landing-hero signature (research R11): a damped rotary harmonograph computed at build time,
// shipped as one inline SVG path and drawn once with CSS. No JavaScript; decorative only.
import { harmonograph, normalizeToViewBox, toSvgPath, type HarmonographParams } from '../lib/curves.ts';

interface Props {
  params?: HarmonographParams;
  samples?: number;
  class?: string;
}

const defaultParams: HarmonographParams = {
  x: [
    { amplitude: 1, frequency: 2, phase: Math.PI / 2 },
    { amplitude: 0.7, frequency: 5.006, phase: 0 },
  ],
  y: [
    { amplitude: 1, frequency: 2, phase: 0 },
    { amplitude: 0.7, frequency: 5.006, phase: Math.PI / 2 },
  ],
  damping: 0.03,
  duration: 70,
};

const { params = defaultParams, samples = 1800, class: className } = Astro.props;
const size = 600;
const d = toSvgPath(normalizeToViewBox(harmonograph(params, samples), size, size, 12));
---

<svg
  class:list={['hero-curve', className]}
  viewBox={`0 0 ${size} ${size}`}
  aria-hidden="true"
  focusable="false"
  preserveAspectRatio="xMidYMid meet"
>
  <path d={d} pathLength="1"></path>
</svg>

<style>
  .hero-curve {
    width: 100%;
    height: auto;
    overflow: visible;
    pointer-events: none;
  }

  path {
    fill: none;
    stroke: var(--color-curve);
    stroke-width: 1.15;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw var(--dur-draw) cubic-bezier(0.45, 0.05, 0.25, 1) 0.15s forwards;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
