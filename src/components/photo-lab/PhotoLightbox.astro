---
// Full-screen viewer shared by the photo displays. Any link with data-photo-open="<index>" opens
// photo <index> of `photos` here; without JavaScript those links simply go to the large image.
// Arrow keys and the buttons move through the set; Escape, Close or a click outside the photo
// closes it and returns focus to the link that opened it.
import { cameraParts, takenLabel, type Photo } from './photos.ts';

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;
const data = photos.map((photo) => ({
  src: photo.full,
  alt: photo.alt,
  title: photo.title,
  taken: takenLabel(photo.taken),
  camera: cameraParts(photo.camera),
  width: photo.width,
  height: photo.height,
}));
---

<dialog class="lightbox" aria-label="Photo viewer" data-lightbox>
  <figure class="lightbox__figure">
    <img class="lightbox__img" alt="" data-lightbox-img />
    <figcaption class="lightbox__caption">
      <span class="lightbox__title" data-lightbox-title></span>
      <span class="lightbox__meta" data-lightbox-meta></span>
    </figcaption>
  </figure>
  <div class="lightbox__controls">
    <button type="button" class="lightbox__button" data-lightbox-prev>Previous</button>
    <span class="lightbox__count" data-lightbox-count></span>
    <button type="button" class="lightbox__button" data-lightbox-next>Next</button>
    <button type="button" class="lightbox__button lightbox__close" data-lightbox-close>Close</button>
  </div>
</dialog>
<script type="application/json" data-lightbox-data set:html={JSON.stringify(data)} />

<script>
  type Item = { src: string; alt: string; title: string; taken: string; camera: string[]; width: number; height: number };

  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const raw = document.querySelector('[data-lightbox-data]')?.textContent;
  if (dialog && raw) {
    const items: Item[] = JSON.parse(raw);
    const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const title = dialog.querySelector('[data-lightbox-title]')!;
    const meta = dialog.querySelector('[data-lightbox-meta]')!;
    const count = dialog.querySelector('[data-lightbox-count]')!;
    let index = 0;
    let opener: HTMLElement | null = null;

    const show = (next: number) => {
      index = (next + items.length) % items.length;
      const item = items[index];
      img.src = item.src;
      img.alt = item.alt;
      img.width = item.width;
      img.height = item.height;
      title.textContent = item.title;
      meta.replaceChildren(
        ...[item.taken, ...item.camera].filter(Boolean).map((part) => {
          const span = document.createElement('span');
          span.textContent = part;
          return span;
        }),
      );
      count.textContent = `${index + 1} of ${items.length}`;
    };

    document.addEventListener('click', (event) => {
      const link = (event.target as Element).closest<HTMLElement>('[data-photo-open]');
      if (!link) return;
      event.preventDefault();
      opener = link;
      show(Number(link.dataset.photoOpen));
      dialog.showModal();
    });

    dialog.querySelector('[data-lightbox-prev]')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-lightbox-next]')!.addEventListener('click', () => show(index + 1));
    dialog.querySelector('[data-lightbox-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });
    // A click on the backdrop (the dialog itself, outside its content) closes it.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => opener?.focus());
  }
</script>

<style>
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100svh;
    max-height: 100svh;
    margin: 0;
    padding: var(--space-s) var(--gutter);
    border: 0;
    background: color-mix(in srgb, var(--color-bg) 94%, transparent);
    color: var(--color-text);
  }

  .lightbox[open] {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: var(--space-s);
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox__figure {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: var(--space-2xs);
    min-height: 0;
    margin: 0;
    justify-items: center;
  }

  .lightbox__img {
    width: auto;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: var(--radius-s);
  }

  .lightbox__caption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: var(--space-3xs) var(--space-s);
    text-align: center;
  }

  .lightbox__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
  }

  .lightbox__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 var(--space-xs);
    color: var(--color-muted);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  .lightbox__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
  }

  .lightbox__button {
    min-height: var(--tap);
    padding-inline: var(--space-s);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: transparent;
    font-weight: 600;
    cursor: pointer;
  }

  .lightbox__close {
    margin-inline-start: var(--space-s);
  }

  .lightbox__count {
    min-width: 5ch;
    text-align: center;
    color: var(--color-muted);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  @media (hover: hover) {
    .lightbox__button:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }
  }
</style>
