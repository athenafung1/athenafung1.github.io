---
// Hidden until src/scripts/theme.ts reveals it, so without JavaScript there is no dead control
// and the page simply follows the device setting (FR-034 edge case).
---

<button type="button" class="theme-toggle tap-target" data-theme-toggle aria-pressed="false" hidden>
  <span class="visually-hidden">Dark theme</span>
  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
    <g class="sun" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <circle cx="12" cy="12" r="4.2"></circle>
      <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path>
    </g>
    <path class="moon" fill="currentColor" d="M20.2 14.6A8.5 8.5 0 0 1 9.4 3.8a8.5 8.5 0 1 0 10.8 10.8Z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    grid-area: toggle;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .sun,
  .moon {
    transform-origin: 12px 12px;
    transition:
      opacity var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  /* aria-pressed="true" means dark is active: show the sun (switch to light). */
  .theme-toggle[aria-pressed='false'] .sun,
  .theme-toggle[aria-pressed='true'] .moon {
    opacity: 0;
    transform: rotate(-60deg) scale(0.6);
  }

  @media (hover: hover) {
    .theme-toggle:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }
  }
</style>
