---
// The only way to render content images: AVIF/WebP, explicit dimensions, responsive widths,
// lazy by default (constitution Principle IV; FR-025 alt rules).
import { Picture as AstroPicture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  decorative?: boolean;
  widths?: number[];
  sizes?: string;
  eager?: boolean;
  class?: string;
}

const {
  src,
  alt,
  decorative = false,
  widths = [320, 480, 640, 960, 1280],
  sizes = '(min-width: 48rem) 50vw, 100vw',
  eager = false,
  class: className,
} = Astro.props;

if (!decorative && !alt.trim()) {
  throw new Error(`Picture: missing alt text for ${src.src}. Describe the image or pass decorative.`);
}

// Never upscale: keep only widths the source can supply, plus the source width itself.
const usableWidths = [...new Set([...widths.filter((w) => w < src.width), src.width])];
---

<AstroPicture
  src={src}
  alt={decorative ? '' : alt}
  formats={['avif', 'webp']}
  widths={usableWidths}
  sizes={sizes}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={eager ? 'high' : undefined}
  class={className}
/>
